# Model Registry Environment Variables
# Copy to .env and fill in actual values

# Required
MODEL_REGISTRY_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/model_registry

# Optional (with defaults)
MODEL_REGISTRY_SERVICE_NAME=model-registry
MODEL_REGISTRY_PORT=8155
MODEL_REGISTRY_VERSION=0.1.0
MODEL_REGISTRY_ENVIRONMENT=production
MODEL_REGISTRY_LOG_LEVEL=INFO
MODEL_REGISTRY_LOG_FORMAT=json

# Routing cache
MODEL_REGISTRY_ROUTING_CACHE_TTL=60

# MinIO / object storage
MODEL_REGISTRY_MINIO_ENDPOINT=minio.minio.svc.example.com:9000

# Secrets (no defaults - must be set)
MODEL_REGISTRY_MINIO_ACCESS_KEY=
MODEL_REGISTRY_MINIO_SECRET_KEY=

# GitOps deployment
MODEL_REGISTRY_GITOPS_REPO_PATH=/tmp/gitops-production
MODEL_REGISTRY_GITOPS_ENABLED=false

# Deployment tracking
MODEL_REGISTRY_DEPLOYMENT_TRACKING_ENABLED=false

# Observability
MODEL_REGISTRY_OTLP_TRACES_ENDPOINT=http://grafana-agent:4318/v1/traces
